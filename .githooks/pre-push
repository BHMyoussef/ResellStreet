#!/usr/bin/env bash
# Gate for deployments: pushing main runs `npm run check:all` against the Local site first (main → staging deploy).
# The Local site serves this folder, so the tests must see exactly the commit being pushed: clean tree required.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

pushes_main=false
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    pushes_main=true
    [ "$local_sha" = "$(git rev-parse HEAD)" ] || { echo "pre-push: check out the commit you push to main (HEAD ≠ $local_sha)."; exit 1; }
  fi
done
$pushes_main || exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: uncommitted changes. Commit or stash them: the tests must run on the pushed commit."; exit 1
fi
if ! curl -sf -o /dev/null --max-time 10 http://resellstreet.local/; then
  echo "pre-push: http://resellstreet.local is not reachable. Start the site in Local (tests run against it)."; exit 1
fi
echo "pre-push: main → running npm run check:all (deploys to staging after the push)…"
npm run check:all
